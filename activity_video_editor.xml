<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://android.com"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="#1E1E1E">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_permanent"
                android:textColor="#03DAC6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStorage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cache_storage"
                android:textColor="#A0A0A0"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_below="@id/topBar"
            android:layout_margin="16dp"
            android:background="#1E1E1E">

            <com.google.android.exoplayer2.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="true" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/scriptContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/videoContainer"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etScenario"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="#1E1E1E"
                android:gravity="top|start"
                android:hint="@string/script_hint"
                android:textColorHint="#A0A0A0"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:inputType="textMultiLine"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnGenerateAiVideo"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_generate"
                android:backgroundTint="#BB86FC"
                android:textColor="#121212"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/scriptContainer"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_alignParentBottom="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_tools_title"
                android:textColor="#E1E1E1"
                android:textSize="14sp"
                android:layout_marginBottom="15dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnCompress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="@string/btn_compress"
                    android:backgroundTint="#2A2A2A"
                    android:textColor="#BB86FC"
                    style="?android:attr/buttonBarButtonStyle" />

                <Button
                    android:id="@+id/btnCut"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="@string/btn_cut"
                    android:backgroundTint="#2A2A2A"
                    android:textColor="#BB86FC"
                    style="?android:attr/buttonBarButtonStyle" />

                <Button
                    android:id="@+id/btnExport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="@string/btn_export"
                    android:backgroundTint="#BB86FC"
                    android:textColor="#121212"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
